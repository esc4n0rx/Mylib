dev.local.bat

# local FFmpeg/FFprobe binaries (large, platform-specific; install.sh/install.ps1 install
# these system-wide instead of bundling them in the repo)
/tools/ffmpeg/*.exe
/tools/ffmpeg/ffmpeg
/tools/ffmpeg/ffprobe
/tools/ffmpeg/ffplay

# output of scripts/package-avatars.sh: a release asset, never a git-tracked file
# (data/avatars itself is already excluded by the /data rule above)
/mylib-avatars.tar.gz
